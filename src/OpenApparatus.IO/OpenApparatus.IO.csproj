<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net8.0 targets the desktop Studio app. The IO lib is authoring/build-time
         only; the Unity package consumes its export *outputs*, not its types, and
         doesn't need this DLL at runtime. -->
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>OpenApparatus.IO</RootNamespace>
    <AssemblyName>OpenApparatus.IO</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenApparatus.Core\OpenApparatus.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SharpGLTF.Toolkit" Version="1.0.4" />
  </ItemGroup>

</Project>
